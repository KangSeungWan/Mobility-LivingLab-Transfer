# 이 파일을 복사해 이름을 .env 로 바꾸고 키를 넣으세요. (.env는 절대 깃허브에 올리지 마세요)

# 공공데이터포털 '일반 인증키(Decoding)' — TAGO 버스도착정보 + TAGO 버스정류소정보에 같은 키 사용
DATA_GO_KR_KEY=

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키 (카카오 지도 표시 · 없으면 OpenStreetMap 지도)
KAKAO_JS_KEY=

# 카카오 REST API 키 — 장소 검색 + (권한 있으면) 택시 시간·요금. 길찾기 권한이 없으면 택시는 고정값
KAKAO_REST_KEY=

# 타슈 Open API 키 (타슈 앱 > 자전거정보 > Open API에서 발급)
TASHU_KEY=

# (선택) 대전시 정류소별 도착정보 주소가 바뀌었을 때만 수정
# DJ_ARRIVAL_URL=https://apis.data.go.kr/6300000/arrive/getArrInfoByUid

# (선택) 지하철 시각표 응답 형식 확인용: 공공데이터포털 > 대전교통공사_열차시각표 > 미리보기에서 나온
#  요청 주소를 serviceKey 부분만 빼고 그대로 붙여 넣기 → /health.html 에서 원본 응답 확인
# DJ_SUBWAY_TEST_URL=

# 1로 두면 키가 있어도 예시 데이터로 실행
MOCK=0

# (배포용) Vercel에서 /health.html 을 쓰려면 임의의 긴 문자열을 넣고 health.html?token=그문자열 로 접속. 비우면 배포 환경에서 점검이 꺼짐
# HEALTH_TOKEN=

# (선택) 제공기관별 하루 호출 한도. 비우면 코드의 기본값을 씁니다. 실제 승인량보다 낮게 잡으세요.
# 이름: TAGO_STOPS, TAGO_ARRIVAL, DJ_ARRIVAL, SUBWAY, KAKAO_DRIVE, KAKAO_SEARCH, TASHU
# QUOTA_TAGO_ARRIVAL=8000
# QUOTA_KAKAO_DRIVE=3000

# (선택·배포용) 서버 인스턴스 전체의 호출 합계를 세는 공유 저장소 (Upstash Redis REST).
# 넣지 않으면 서버 인스턴스마다 따로 셉니다. 저장소 장애 시 기본은 외부 조회 중단, QUOTA_FAIL_OPEN=1이면 통과.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# QUOTA_FAIL_OPEN=0
