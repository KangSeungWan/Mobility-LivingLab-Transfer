# 이 파일을 복사해 이름을 .env 로 바꾸고 키를 넣으세요. (.env는 절대 깃허브에 올리지 마세요)

# 공공데이터포털 '일반 인증키(Decoding)' — TAGO 버스도착정보 + TAGO 버스정류소정보에 같은 키 사용
DATA_GO_KR_KEY=

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키 (카카오 지도 표시 · 없으면 OpenStreetMap 지도)
KAKAO_JS_KEY=

# 카카오 REST API 키 — 장소 검색 + (권한 있으면) 택시 시간·요금. 길찾기 권한이 없으면 택시는 고정값
KAKAO_REST_KEY=

# 타슈 Open API 키 (타슈 앱 > 자전거정보 > Open API에서 발급)
TASHU_KEY=

# (선택) 대전시 정류소별 도착정보 주소가 바뀌었을 때만 수정
# DJ_ARRIVAL_URL=https://apis.data.go.kr/6300000/arrive/getArrInfoByUid

# (선택) 지하철 시각표 응답 형식 확인용: 공공데이터포털 > 대전교통공사_열차시각표 > 미리보기에서 나온
#  요청 주소를 serviceKey 부분만 빼고 그대로 붙여 넣기 → /health.html 에서 원본 응답 확인
# DJ_SUBWAY_TEST_URL=

# 1로 두면 키가 있어도 예시 데이터로 실행
MOCK=0
